# name: test/sql/iceberg_to_ducklake.test_slow
# description: Self-contained conversion of larger data, position deletes, and retained history
# group: [sql]

require-env CATALOG_TEST_CONFIG_SETUP

require-env STAGED_CREATE_SUPPORT

include test/sql/init_requires

require ducklake

statement ok
DROP TABLE IF EXISTS my_datalake.default.conversion_stress;

statement ok
DROP TABLE IF EXISTS my_datalake.default.conversion_stress_roundtrip;

statement ok
CREATE TABLE my_datalake.default.conversion_stress AS
SELECT i AS id, 'label-' || (i % 11) AS label, {'x': i * 2, 'y': [i * 0.5, NULL]} AS nested
FROM range(100000) r(i);

statement ok
DELETE FROM my_datalake.default.conversion_stress WHERE id % 100 = 0;

statement ok
INSERT INTO my_datalake.default.conversion_stress
SELECT i, 'label-' || (i % 11), {'x': i * 2, 'y': [i * 0.5, NULL]}
FROM range(100000, 100100) r(i);

statement ok
ALTER TABLE my_datalake.default.conversion_stress RENAME COLUMN label TO renamed;

statement ok
ATTACH 'ducklake:{TEST_DIR}/conversion_stress.ducklake' AS stress_lake
(DATA_PATH '{TEST_DIR}/conversion_stress_files', DATA_INLINING_ROW_LIMIT 0);

query I
CALL iceberg_to_ducklake('my_datalake', 'stress_lake', tables := ['default.conversion_stress']);
----
1

query II
SELECT count(*), sum(id) FROM stress_lake.default.conversion_stress;
----
99100	4960004950

query I rowsort matching_sample
SELECT * FROM my_datalake.default.conversion_stress WHERE id % 997 = 0;
----

query I rowsort matching_sample
SELECT * FROM stress_lake.default.conversion_stress WHERE id % 997 = 0;
----

reset label matching_sample

statement ok
INSERT INTO stress_lake.default.conversion_stress VALUES (999999, 'new', {'x': 1999998, 'y': [499999.5, NULL]});

statement ok
ALTER TABLE stress_lake.default.conversion_stress RENAME TO conversion_stress_roundtrip;

query I
CALL ducklake_to_iceberg('stress_lake', 'my_datalake', tables := ['default.conversion_stress_roundtrip']);
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.default.conversion_stress_roundtrip;
----
99101	4961004949

query I
SELECT count(*) > 3 FROM iceberg_snapshots('my_datalake.default.conversion_stress_roundtrip');
----
true

statement ok
DROP TABLE my_datalake.default.conversion_stress;

statement ok
DROP TABLE my_datalake.default.conversion_stress_roundtrip;
