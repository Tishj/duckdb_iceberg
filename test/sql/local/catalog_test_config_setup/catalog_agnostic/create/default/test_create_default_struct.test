# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/default/test_create_default_struct.test
# description: Regression for non-flat vector in ManifestListReader when manifest_list has many entries
# group: [default]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
drop table if exists my_datalake.default.tbl;

statement ok
SET GLOBAL __iceberg_unsafe_struct_null_default_interpretation = '{}';

# A non-null STRUCT default must explicitly opt in with the sentinel.
statement error
create table my_datalake.default.tbl_missing_struct_sentinel(
	col STRUCT(a VARCHAR) DEFAULT {'a': 'test'}
) WITH ('format-version' = 3);
----
Invalid Input Error: Non-null DEFAULT values for STRUCT must contain the field '__duckdb_struct_default'

# The sentinel itself only accepts NULL.
statement error
create table my_datalake.default.tbl_invalid_struct_sentinel(
	col STRUCT(a VARCHAR) DEFAULT {'__duckdb_struct_default': 42, 'a': 'test'}
) WITH ('format-version' = 3);
----
Invalid Input Error: The field '__duckdb_struct_default' only supports NULL as its value

# It is not a way to bypass normal field-name validation.
statement error
create table my_datalake.default.tbl_unknown_struct_field(
	col STRUCT(a VARCHAR)
		DEFAULT {'__duckdb_struct_default': NULL, 'missing': 'test'}
) WITH ('format-version' = 3);
----
Invalid Input Error: DEFAULT field 'missing' does not exist in STRUCT type STRUCT(a VARCHAR)

# A physical field cannot use the reserved sentinel name when the STRUCT has a non-null default.
statement error
create table my_datalake.default.tbl_reserved_struct_field(
	col STRUCT("__duckdb_struct_default" INTEGER, a VARCHAR)
		DEFAULT {'__duckdb_struct_default': NULL, 'a': 'test'}
) WITH ('format-version' = 3);
----
Invalid Input Error: The field name '__duckdb_struct_default' is reserved in STRUCT types that have a DEFAULT value

# Every nested non-null STRUCT literal must carry its own sentinel.
statement error
create table my_datalake.default.tbl_missing_nested_struct_sentinel(
	col STRUCT(b STRUCT(x INTEGER))
		DEFAULT {'__duckdb_struct_default': NULL, 'b': {'x': 42}}
) WITH ('format-version' = 3);
----
Invalid Input Error: Non-null DEFAULT values for STRUCT must contain the field '__duckdb_struct_default'

# Sentinel-bearing defaults remain a v3 feature.
statement error
create table my_datalake.default.tbl_v2_struct_default(
	col STRUCT(a VARCHAR)
		DEFAULT {'__duckdb_struct_default': NULL, 'a': 'test'}
) WITH ('format-version' = 2);
----
Invalid Input Error: non-null DEFAULT values are not supported for <V3 tables

# The sentinel records the intended non-null STRUCT default while Iceberg metadata stores NULL.
statement ok
create table my_datalake.default.tbl(
	col STRUCT(
		a VARCHAR,
		b INTEGER,
		c BLOB
	) DEFAULT {'__duckdb_struct_default': NULL, 'a': 'test', 'b': NULL},
	col2 BLOB
) WITH (
	'format-version'= 3
);

query I
SELECT contains(metadata::VARCHAR, '__duckdb_struct_default')
FROM iceberg_load_table_response(my_datalake.default.tbl);
----
false

# in: - (col not provided)
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': NULL, 'c': NULL}
statement ok
insert into my_datalake.default.tbl (col2) VALUES ('\xaa\xff\xaa'), ('\xAA\xFF\xAA\xAA\xFF\xAA')

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# in: {'b': 42}
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': 42, 'c': NULL}
statement ok
insert into my_datalake.default.tbl 
	VALUES ({'b': 42}, NULL)

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': 42, 'c': NULL}	NULL
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# in: {'c': '\xaa\xff\xaa'}
# col.default: {}
# col.a.default: 'test'
# col.b.default: NULL
# col.c.default: -
# result: {'a': test, 'b': NULL, 'c': '\xaa\xff\xaa'}
statement ok
insert into my_datalake.default.tbl 
	VALUES ({'c': '\xaa\xff\xaa'}, NULL)

query II
select * from my_datalake.default.tbl order by all;
----
{'a': test, 'b': 42, 'c': NULL}	NULL
{'a': test, 'b': NULL, 'c': \xAA\xFF\xAA}	NULL
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA
{'a': test, 'b': NULL, 'c': NULL}	\xAA\xFF\xAA\xAA\xFF\xAA

# Struct nested within another struct

statement ok
drop table if exists my_datalake.default.nested_tbl;

# Every non-null nested STRUCT default has its own sentinel.
statement ok
create table my_datalake.default.nested_tbl(
	col STRUCT(
		a VARCHAR,
		b STRUCT(
			v1 BIGINT,
			v2 BIGINT,
			v3 BIGINT
		),
		e BOOLEAN
	) DEFAULT {
		'__duckdb_struct_default': NULL,
		'a': 'test',
		'b': {
			'__duckdb_struct_default': NULL,
			'v1': 1000,
			'v3': -500
		},
		'e': NULL
	},
	col2 INTEGER
) WITH (
	'format-version'= 3
);

# col.b.in: -
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': -500}
statement ok
insert into my_datalake.default.nested_tbl (col2) VALUES (12)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12

# Only supply b.v3, which has a default of -500

# col.b.in: {'v3': NULL}
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': NULL}
statement ok
insert into my_datalake.default.nested_tbl 
	VALUES (
		{
			'b': {
				'v3': NULL
			}
		},
		24
	)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': NULL}, 'e': NULL}	24

# Only supply b.v2, which has no default

# col.b.in: {'v3': 42}
# col.b.default: {}
# col.b.v1.default: 1000
# col.b.v2.default: -
# col.b.v3.default: -500
# col.b.result: {'v1': 1000, 'v2': NULL, 'v3': 42}
statement ok
insert into my_datalake.default.nested_tbl 
	VALUES (
		{
			'b': {
				'v2': 250
			}
		},
		24
	)

query II
select * from my_datalake.default.nested_tbl order by all;
----
{'a': test, 'b': {'v1': 1000, 'v2': 250, 'v3': -500}, 'e': NULL}	24
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': -500}, 'e': NULL}	12
{'a': test, 'b': {'v1': 1000, 'v2': NULL, 'v3': NULL}, 'e': NULL}	24

statement ok
RESET __iceberg_unsafe_struct_null_default_interpretation;

# In the default safe mode, DEFAULT NULL on a STRUCT remains NULL.

statement ok
drop table if exists my_datalake.default.tbl_default_null_struct;

statement ok
create table my_datalake.default.tbl_default_null_struct(
	id INTEGER,
	col STRUCT(
		a VARCHAR,
		b INTEGER,
		c STRUCT(
			x BIGINT
		)
	) DEFAULT NULL
) WITH (
	'format-version' = 3
);

statement ok
insert into my_datalake.default.tbl_default_null_struct values
	(1, DEFAULT),
	(2, DEFAULT);

query II
select * from my_datalake.default.tbl_default_null_struct order by id;
----
1	NULL
2	NULL
