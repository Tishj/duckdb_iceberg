# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/create/default/test_create_default_fixed_geometry.test
# description: Geometry defaults must match the destination fixed binary width
# group: [default]

require-env CATALOG_TEST_CONFIG_SETUP

require-env COLUMN_DEFAULT_SUPPORT

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

foreach geometry_type GEOMETRY GEOMETRY('OGC:CRS84') GEOMETRY('OGC:CRS83')

statement ok
DROP TABLE IF EXISTS my_datalake.default.fixed_geometry_default;

statement error
CREATE TABLE my_datalake.default.fixed_geometry_default (
    f ICEBERG_FIXED(4) DEFAULT 'POINT (1 2)'::{geometry_type}
) WITH ('format-version'='3');
----
Expected 4 bytes for ICEBERG_FIXED(4), got 21

statement error
CREATE TABLE my_datalake.default.fixed_geometry_default (
    s STRUCT(f ICEBERG_FIXED(4)) DEFAULT {'f': 'POINT (1 2)'::{geometry_type}}
) WITH ('format-version'='3');
----
Expected 4 bytes for ICEBERG_FIXED(4), got 21

query I
SELECT count(*) FROM information_schema.tables
WHERE table_catalog = 'my_datalake' AND table_schema = 'default' AND table_name = 'fixed_geometry_default';
----
0

statement ok
CREATE TABLE my_datalake.default.fixed_geometry_default (
    id INTEGER,
    f ICEBERG_FIXED(21) DEFAULT 'POINT (1 2)'::{geometry_type},
    n ICEBERG_FIXED(4) DEFAULT NULL::{geometry_type}
) WITH ('format-version'='3');

statement ok
INSERT INTO my_datalake.default.fixed_geometry_default (id) VALUES (1);

statement error
ALTER TABLE my_datalake.default.fixed_geometry_default
ADD COLUMN bad ICEBERG_FIXED(4) DEFAULT 'POINT (1 2)'::{geometry_type};
----
Expected 4 bytes for ICEBERG_FIXED(4), got 21

statement error
ALTER TABLE my_datalake.default.fixed_geometry_default
ALTER COLUMN f SET DEFAULT 'LINESTRING (0 0, 1 1)'::{geometry_type};
----
Expected 21 bytes for ICEBERG_FIXED(21), got 41

statement ok
ALTER TABLE my_datalake.default.fixed_geometry_default
ADD COLUMN g ICEBERG_FIXED(21) DEFAULT 'POINT (3 4)'::{geometry_type};

statement ok
INSERT INTO my_datalake.default.fixed_geometry_default (id) VALUES (2);

# The added column's initial default and both write defaults round-trip through metadata.
query IIII
SELECT id, f = 'POINT (1 2)'::GEOMETRY::BLOB, n IS NULL, g = 'POINT (3 4)'::GEOMETRY::BLOB
FROM my_datalake.default.fixed_geometry_default ORDER BY id;
----
1	true	true	true
2	true	true	true

statement ok
DROP TABLE my_datalake.default.fixed_geometry_default;

endloop
