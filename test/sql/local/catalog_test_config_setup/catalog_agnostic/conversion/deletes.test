# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/conversion/deletes.test
# description: Reuse position deletes and historical Puffin vectors without rewriting
# group: [conversion]

require-env CATALOG_TEST_CONFIG_SETUP

require-env STAGED_CREATE_SUPPORT

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

require ducklake

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.conversion;

statement ok
DROP TABLE IF EXISTS my_datalake.conversion.position_export;

statement ok
DROP TABLE IF EXISTS my_datalake.conversion.vector_export;

statement ok
DROP TABLE IF EXISTS my_datalake.conversion.position_seed;

statement ok
DROP TABLE IF EXISTS my_datalake.conversion.native_position;

statement ok
CREATE TABLE my_datalake.conversion.position_seed AS SELECT i AS id FROM range(1000) r(i);

statement ok
DELETE FROM my_datalake.conversion.position_seed WHERE id % 2 = 0;

statement ok
ATTACH 'ducklake:{TEST_DIR}/position_source.ducklake' AS pos_lake
(DATA_PATH '{WORKING_DIRECTORY}/{TEST_DIR}/position_files', DATA_INLINING_ROW_LIMIT 0);

query I
CALL iceberg_to_ducklake('my_datalake', 'pos_lake', tables := ['conversion.position_seed']);
----
1

statement ok
ALTER TABLE pos_lake.conversion.position_seed RENAME TO position_export;

query I
CALL ducklake_to_iceberg('pos_lake', 'my_datalake', tables := ['conversion.position_export']);
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.position_export;
----
500	250000

statement ok
ATTACH 'ducklake:{TEST_DIR}/position_back.ducklake' AS pos_back (DATA_PATH '{TEST_DIR}/position_back_files');

query I
CALL iceberg_to_ducklake('my_datalake', 'pos_back', tables := ['conversion.position_export']);
----
1

query II
SELECT count(*), sum(id) FROM pos_back.conversion.position_export;
----
500	250000

statement ok
DELETE FROM pos_lake.conversion.position_export WHERE id < 100;

statement ok
ALTER TABLE pos_lake.conversion.position_export RENAME TO position_incompatible;

statement error
CALL ducklake_to_iceberg('pos_lake', 'my_datalake', tables := ['conversion.position_incompatible']);
----
per-row snapshot filtering

statement ok
ATTACH 'ducklake:{TEST_DIR}/vector_source.ducklake' AS vector_lake
(DATA_PATH '{WORKING_DIRECTORY}/{TEST_DIR}/vector_files', DATA_INLINING_ROW_LIMIT 0, WRITE_DELETION_VECTORS true);

statement ok
CREATE SCHEMA vector_lake.conversion;

statement ok
CREATE TABLE vector_lake.conversion.vector_export AS SELECT i AS id FROM range(1000) r(i);

statement ok
SET VARIABLE vector_insert = (SELECT id FROM ducklake_current_snapshot('vector_lake'));

statement ok
DELETE FROM vector_lake.conversion.vector_export WHERE id % 2 = 0;

statement ok
SET VARIABLE vector_first_delete = (SELECT id FROM ducklake_current_snapshot('vector_lake'));

statement ok
DELETE FROM vector_lake.conversion.vector_export WHERE id < 100;

query I
CALL ducklake_to_iceberg('vector_lake', 'my_datalake', tables := ['conversion.vector_export']);
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.vector_export;
----
450	247500

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.vector_export AT (VERSION => getvariable('vector_first_delete'));
----
500	250000

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.vector_export AT (VERSION => getvariable('vector_insert'));
----
1000	499500

statement ok
ATTACH 'ducklake:{TEST_DIR}/vector_back.ducklake' AS vector_back (DATA_PATH '{TEST_DIR}/vector_back_files');

# The inverse cannot select a source blob by offset in DuckLake metadata.
statement error
CALL iceberg_to_ducklake('my_datalake', 'vector_back', tables := ['conversion.vector_export']);
----
multiple blobs

query I
SELECT max(snapshot_id) FROM __ducklake_metadata_vector_back.ducklake_snapshot;
----
0

# The compatibility build writes standard Iceberg field IDs for new DuckLake deletes.
statement ok
CREATE TABLE pos_lake.conversion.native_position AS SELECT i AS id FROM range(1000) r(i);

statement ok
DELETE FROM pos_lake.conversion.native_position WHERE id % 2 = 0;

query I
CALL ducklake_to_iceberg('pos_lake', 'my_datalake', tables := ['conversion.native_position']);
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.native_position;
----
500	250000

statement ok
DROP TABLE my_datalake.conversion.position_export;

statement ok
DROP TABLE my_datalake.conversion.vector_export;

statement ok
DROP TABLE my_datalake.conversion.position_seed;

statement ok
DROP TABLE my_datalake.conversion.native_position;
