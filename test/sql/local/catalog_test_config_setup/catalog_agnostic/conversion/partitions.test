# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/conversion/partitions.test
# description: Epoch time and bucket mappings must preserve filtered query results
# group: [conversion]

require-env CATALOG_TEST_CONFIG_SETUP

require-env STAGED_CREATE_SUPPORT

include test/sql/init_requires

require ducklake

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.conversion;

statement ok
DROP TABLE IF EXISTS my_datalake.conversion.partitioned;

statement ok
ATTACH 'ducklake:{TEST_DIR}/partitions.ducklake' AS part_lake (DATA_PATH '{TEST_DIR}/partition_data', DATA_INLINING_ROW_LIMIT 0);

statement ok
CREATE SCHEMA part_lake.conversion;

statement ok
CREATE TABLE part_lake.conversion.partitioned (id INTEGER, ts TIMESTAMP, label VARCHAR);

statement ok
ALTER TABLE part_lake.conversion.partitioned SET PARTITIONED BY (bucket(4, id), year(ts));

statement ok
INSERT INTO part_lake.conversion.partitioned VALUES
    (1, '1969-12-31 23:59:59', 'old'), (2, '1970-01-01', 'epoch'), (3, '2020-02-03', 'new');

statement ok
ALTER TABLE part_lake.conversion.partitioned SET PARTITIONED BY (label);

statement ok
INSERT INTO part_lake.conversion.partitioned VALUES (4, '2021-01-01', 'O''Brien'), (5, NULL, NULL);

query I
CALL ducklake_to_iceberg('part_lake', 'my_datalake', tables := ['conversion.partitioned']);
----
1

query II
SELECT count(*), sum(id) FROM my_datalake.conversion.partitioned;
----
5	15

query I
SELECT id FROM my_datalake.conversion.partitioned WHERE ts < TIMESTAMP '1970-01-01';
----
1

query I
SELECT id FROM my_datalake.conversion.partitioned WHERE id = 2;
----
2

statement ok
ATTACH 'ducklake:{TEST_DIR}/partitions_back.ducklake' AS part_back (DATA_PATH '{TEST_DIR}/partition_back_data');

query I
CALL iceberg_to_ducklake('my_datalake', 'part_back', tables := ['conversion.partitioned']);
----
1

query II
SELECT count(*), sum(id) FROM part_back.conversion.partitioned;
----
5	15

query I
SELECT id FROM part_back.conversion.partitioned WHERE ts < TIMESTAMP '1970-01-01';
----
1

query I
SELECT id FROM part_back.conversion.partitioned WHERE label = 'O''Brien';
----
4

statement ok
INSERT INTO part_back.conversion.partitioned VALUES (6, '2022-01-01', 'six');

query I
SELECT id FROM part_back.conversion.partitioned WHERE label = 'six';
----
6

statement ok
DROP TABLE my_datalake.conversion.partitioned;
