# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_manifests_historical_schema.test
# description: A rewritten historical spec retains the schema needed to interpret its promoted partition values.
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

require-env METADATA_FILE_READ_SUPPORT

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_manifests_historical_schema;

statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_historical_schema (p INTEGER, payload INTEGER)
PARTITIONED BY (p) WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_historical_schema VALUES (1, 10);

statement ok
ALTER TABLE my_datalake.default.rewrite_manifests_historical_schema ALTER COLUMN p TYPE BIGINT;

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_historical_schema VALUES (2147483648, 20);

statement ok
ALTER TABLE my_datalake.default.rewrite_manifests_historical_schema RESET PARTITIONED BY;

statement ok
ALTER TABLE my_datalake.default.rewrite_manifests_historical_schema DROP COLUMN p;

query II
CALL iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_historical_schema', spec_id => 0);
----
2	1

statement ok
BEGIN;

statement ok
SET VARIABLE historical_manifest = (SELECT path FROM iceberg_manifests(my_datalake.default.rewrite_manifests_historical_schema));

# A reader must be able to resolve the partition spec's source ID against the schema in this Avro file.
query T
WITH header AS (SELECT key, value FROM avro_metadata(getvariable('historical_manifest'))),
fields AS (SELECT unnest(json_extract(value::JSON, '$.fields[*]')) AS field FROM header WHERE key = 'schema')
SELECT field->>'type' FROM fields
WHERE (field->>'id') = (SELECT value::JSON->>'$[0].source-id' FROM header WHERE key = 'partition-spec');
----
long

query TI
SELECT typeof(data_file.partition.p), data_file.partition.p FROM read_avro(getvariable('historical_manifest')) ORDER BY 2;
----
BIGINT	1
BIGINT	2147483648

statement ok
COMMIT;

query I
SELECT payload FROM my_datalake.default.rewrite_manifests_historical_schema ORDER BY payload;
----
10
20

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_historical_schema;
