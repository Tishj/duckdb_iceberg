# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/maintenance/rewrite_manifests_transactions.test
# description: Prepared manifest rewrites plan against the current snapshot and respect concurrent appends.
# group: [maintenance]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.rewrite_manifests_transactions;

statement ok
CREATE TABLE my_datalake.default.rewrite_manifests_transactions (id INTEGER)
WITH ('format-version' = 2, 'commit.manifest-merge.enabled' = false);

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_transactions VALUES (1);

statement ok
PREPARE repack AS SELECT * FROM iceberg_rewrite_manifests('my_datalake.default.rewrite_manifests_transactions');

query II
EXECUTE repack;
----
0	0

statement ok
INSERT INTO my_datalake.default.rewrite_manifests_transactions VALUES (2);

statement ok
BEGIN;

query II
EXECUTE repack;
----
2	1

statement ok writer
INSERT INTO my_datalake.default.rewrite_manifests_transactions VALUES (3);

# A stale replace must not overwrite the concurrent append or reapply its original plan.
statement error
COMMIT;
----
Conflict_409

query II
SELECT count(*), sum(added_data_files_count) FROM iceberg_manifests(my_datalake.default.rewrite_manifests_transactions);
----
3	3

query II
EXECUTE repack;
----
3	1

query I
SELECT list(id ORDER BY id) FROM my_datalake.default.rewrite_manifests_transactions;
----
[1, 2, 3]

statement ok
DROP TABLE my_datalake.default.rewrite_manifests_transactions;
