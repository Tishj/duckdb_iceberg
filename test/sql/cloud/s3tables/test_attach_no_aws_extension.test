# name: test/sql/cloud/s3tables/test_attach_no_aws_extension.test
# description: test that region information from aws service is used as fallback when no region information is provided.
# group: [s3tables]

require-env ICEBERG_AWS_REMOTE_AVAILABLE

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require avro

require parquet

require iceberg

require httpfs

statement ok
create secret s3 (
    type s3,
    KEY_ID '{AWS_ACCESS_KEY_ID}',
    SECRET '{AWS_SECRET_ACCESS_KEY}'
);

statement ok
attach 'arn:aws:s3tables:us-east-1:840140254803:bucket/duckdblabs-iceberg-testing' as my_datalake (
    secret s3,
    type iceberg,
    uri 's3tables.us-east-1.amazonaws.com/iceberg',
    warehouse 'arn:aws:s3tables:us-east-1:840140254803:bucket/duckdblabs-iceberg-testing',
    authorization_type 'sigv4',
    sigv4_service 's3tables',
    sigv4_region 'us-east-1',
    storage_region 'us-east-1',
    storage_endpoint 's3.us-east-1.amazonaws.com',
    storage_credential_source 'catalog',
    stage_create_tables false,
    remove_files_on_delete false,
    purge_requested true
);

statement ok
select * from my_datalake.tpch_sf01.part;
